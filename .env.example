# Copy to your shell profile or session. Never commit real values.
# Required for all data commands. Generate in ManyChat: Settings -> API.
# MANYCHAT_API_KEY=your-api-key-here

# Optional override of the public API endpoint (HTTPS only, no
# creds/query/fragment). Useful for proxies and local mocks.
# MANYCHAT_API_URL=https://api.manychat.com

# Optional override of the browser-transport state directory (default
# ~/.manychat-axi). Mainly for tests and development.
# MANYCHAT_STATE_DIR=~/.manychat-axi
